# ==========================================
# CẤU HÌNH HỆ THỐNG HYBRID RAG ASSISTANT
# ==========================================

# 1. API Keys (Để trống nếu chỉ chạy Retrieval hoặc dùng Offline Mock LLM)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 2. Cấu hình LLM Provider: "mock", "ollama", "gemini", "openai"
LLM_PROVIDER=mock
# Để trống để dùng model mặc định của provider (ollama: OLLAMA_MODEL, openai: gpt-4o-mini, gemini: gemini-2.5-flash).
# Nếu điền, model phải thuộc đúng provider đã chọn ở trên.
LLM_MODEL_NAME=
# Ollama (chạy LLM cục bộ, không cần API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Thời gian chờ tối đa (giây) cho một câu trả lời của LLM
LLM_TIMEOUT=180

# 3. Cấu hình Embedding Model
# Khuyên dùng mô hình đa ngữ nhẹ, chất lượng cao cho tiếng Việt:
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Hoặc mô hình tiếng Việt chuyên sâu: bkai-foundation-models/vietnamese-bi-encoder

# 4. Cấu hình Chunking mặc định
DEFAULT_CHUNK_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# Chuẩn hóa slide: bỏ trang hiệu ứng, tiêu đề lặp lại, gộp trang ngắn hơn MIN_PAGE_CHARS ký tự
SLIDE_CLEANUP=true
MIN_PAGE_CHARS=40

# 5. Cấu hình Retrieval & RRF
FAISS_TOP_K=8
BM25_TOP_K=8
FINAL_TOP_K=5
RRF_K=60

# 6. Đường dẫn thư mục
PDF_DIR=data/pdfs
PROCESSED_DIR=data/processed
INDEX_DIR=data/indexes
EVALUATION_DIR=data/evaluation

# 7. Host & Port
API_HOST=127.0.0.1
API_PORT=8000
UI_HOST=127.0.0.1
UI_PORT=7860
MAX_UPLOAD_MB=50
